# Copy to ~/entertainverse/.env on BOTH servers (same values), then: chmod 600 .env
# Generate each secret with: openssl rand -hex 32
# (hex only: the passwords go inside URLs, where symbols would break them)
AUTH_SECRET=
NEXTAUTH_SECRET=
POSTGRES_PASSWORD=
REDIS_PASSWORD=

# Server A's private IP (stays the same across stop/start)
PRIVATE_IP=172.31.43.215
SERVER_A_IP=172.31.43.215

# Public HTTPS link (Cloudflare named tunnel; the up script keeps it in sync)
APP_URL=https://entertainverse.dpdns.org

# Google sign-in: OAuth client with redirect URI
# https://entertainverse.dpdns.org/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Uploads: the servers' IAM role grants access, so no AWS keys here
S3_BUCKET=entertainverse-reetam-media-978387602393-ap-southeast-2-an
S3_REGION=ap-southeast-2

# Optional: AI features (copy from your .env.local; left empty, they show "not set up")
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
TMDB_API_KEY=
