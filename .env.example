# PostgreSQL — required for user accounts and all persisted data.

DATABASE_URL="postgresql://postgres:password@localhost:5432/entertainverse?schema=public"

# Optional. Set when running more than one app server (behind a load balancer): realtime
# events, party state, cache clears and rate limits are then shared through Redis.
# Leave unset for a single server.
# REDIS_URL="redis://localhost:6379"



# NextAuth — required. Generate with: npx auth secret

AUTH_SECRET="run: npx auth secret"

AUTH_URL="http://localhost:3000"

NEXTAUTH_URL="http://localhost:3000"



# Platform admins (created/updated by npm run db:seed)

# Super Admin — full access to all CMS areas
ADMIN_EMAIL="admin@entertainverse.local"
ADMIN_PASSWORD="Admin123!"
ADMIN_NAME="EntertainVerse Super Admin"
ADMIN_HANDLE="entertainverse_admin"

# Specialist admins (also seeded by db:seed)
# Content Admin: content@entertainverse.local / Content123!
# Music Admin:   music@entertainverse.local   / Music123!
# Artist Admin:  artist@entertainverse.local  / Artist123!



# OAuth providers — optional. The Google/Discord buttons activate once set.
#
# Google: https://console.cloud.google.com/apis/credentials
#   1. Configure the OAuth consent screen (External, add your email as a test user)
#   2. Create Credentials -> OAuth client ID -> "Web application"
#   3. Authorized JavaScript origins:  http://localhost:3000
#   4. Authorized redirect URIs:       http://localhost:3000/api/auth/callback/google
#   (add the same two entries with your production domain before deploying)

AUTH_GOOGLE_ID=""

AUTH_GOOGLE_SECRET=""

AUTH_DISCORD_ID=""

AUTH_DISCORD_SECRET=""



# AI catalog import + review (Admin CMS) — optional; the CMS works without them.
# Provider: "gemini" (free tier) or "claude". Unset = Gemini if its key is set, else Claude.
AI_PROVIDER="gemini"

# Gemini (free tier): https://aistudio.google.com/apikey
# Also powers the recommender's embeddings — run `npm run embed:catalog` once after adding it.
GEMINI_API_KEY=""
# Optional — defaults to "gemini-flash-latest" (always the current Flash model).
GEMINI_MODEL=""
# Optional — fast tier for AI-mode chat, defaults to "gemini-flash-lite-latest" (much bigger free quota;
# the main model allows ~20 requests/day on the free tier and falls back to this one when it runs out).
GEMINI_FAST_MODEL=""

# Claude (paid, prepaid credits): https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=""

# TMDB (movies, shows, K-dramas): https://www.themoviedb.org/settings/api
# Use either the v3 API key or the v4 read access token. Anime import (AniList) needs no key.
TMDB_API_KEY=""
TMDB_READ_ACCESS_TOKEN=""

# Country for "where to watch" providers and Apple Music previews / listen links (ISO code). Default IN.
# Music import needs no key: Apple Music (iTunes Search), Deezer and MusicBrainz are public APIs.
WATCH_REGION="IN"


# Realtime chat (Socket.IO) — optional in dev (defaults to same origin as the app)

NEXT_PUBLIC_SOCKET_URL="http://localhost:3000"

# App URL for Socket.IO CORS in production

NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Talk rooms and live hosting — optional TURN relay for phones on mobile data and strict
# office networks (STUN alone is used otherwise). Served by /api/realtime/ice.
# TURN_URLS="turn:turn.example.com:3478,turns:turn.example.com:5349"
# TURN_USERNAME=""
# TURN_CREDENTIAL=""



# Several app servers (production) — see deploy/ for the real setup.

# Uploads go to this S3 bucket instead of public/ (credentials: the AWS SDK chain, e.g. an
# EC2 instance role; locally AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY).
# S3_BUCKET=""
# S3_REGION="ap-southeast-2"
# Only for an S3-compatible server in development (S3Mock, MinIO).
# S3_ENDPOINT="http://localhost:9090"

# Shown by /api/health so you can tell servers apart.
# SERVER_NAME="a"
# After SIGTERM, keep serving this long while the load balancer notices (default 10000 in production).
# SHUTDOWN_DRAIN_MS="10000"
# "off" bypasses the server cache (debugging).
# SERVER_CACHE="off"
